# Pin to a published digest for repeatable deployments.
LASTEST_IMAGE=ghcr.io/lasnet/lastest:dev
LASTEST_DATA_VOLUME=lastest-data

# Address on the Docker host. Use a LAN or VPN address for direct network access.
LASTEST_HOST_IP=127.0.0.1
LASTEST_PORT=8080

# Use true with HTTPS. Set false for HTTP on loopback or a trusted network.
LASTEST_SECURE_COOKIES=false

# Only administrator-approved internal networks may be scanned. Leave empty for
# public-target-only deployments. Example test stand: 127.0.0.0/8
LASTEST_INTERNAL_RANGES=

# Optional providers. Missing optional keys are visible in the task catalog and
# do not block the rest of the product.
LASTEST_CERTSPOTTER_TOKEN=
LASTEST_CENSYS_API_ID=
LASTEST_CENSYS_API_SECRET=

# Optional separately installed Nmap adapter (fixed unprivileged profile).
LASTEST_NMAP_PATH=
# Subfinder is included in the image. Set a custom path for native installations.
LASTEST_SUBFINDER_PATH=/usr/local/bin/subfinder
LASTEST_LOG_LEVEL=info
